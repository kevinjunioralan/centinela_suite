{
  "name": "centinela-banco-pruebas-backend",
  "version": "1.0.0",
  "description": "Backend del módulo Centinela Banco de Pruebas",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "dev:verbose": "node scripts/run-backend-verbose.js",
    "dev:production": "node scripts/run-backend-verbose.js",
    "ops:gate": "node scripts/ops-production-gate.js",
    "ops:production:gate": "node scripts/ops-production-gate.js",
    "ops:production:readiness": "node scripts/ops-readiness-gate.js",
    "ops:contingency:drill": "node scripts/ops-contingency-drill.js",
    "ops:risk:audit": "node scripts/ops-residual-risk-audit.js",
    "ops:hardening:block": "node scripts/ops-hardening-block.js",
    "start": "node src/index.js",
    "test": "echo \"No hay tests definidos\" && exit 0",
    "test:contracts:arquitectura": "node --test src/arquitectura/arquitectura.contract.test.js",
    "test:contracts:auditoria": "node --test src/auditor/auditor.contract.test.js",
    "test:contracts:edicion-servidores": "node --test src/edicionServidores/edicionServidores.contract.test.js",
    "test:contracts:informes": "node --test src/informes/informes.historial.contract.test.js",
    "test:contracts:mantenimiento": "node --test src/mantenimiento/mantenimiento.contract.test.js",
    "test:unit:mantenimiento": "node --test src/mantenimiento/MantenimientoHttpResponder.unit.test.js src/mantenimiento/MantenimientoController.unit.test.js src/mantenimiento/MantenimientoValidacionRunner.unit.test.js",
    "test:unit:instalacion": "node --test src/instalacion/InstalacionHttpResponder.unit.test.js src/instalacion/createInstalacionModule.unit.test.js src/instalacion/InstalacionPolicies.unit.test.js src/instalacion/InstalacionRepository.unit.test.js src/instalacion/InstalacionService.unit.test.js",
    "test:contracts:instalacion": "node --test src/instalacion/instalacion.contract.test.js src/instalacion/InstalacionService.lifecycle.test.js src/instalacion/InstaladorSSH.packConfig.test.js",
    "test:contracts:organizacion": "node --test src/organizacion/organizacion.contract.test.js",
    "test:contracts:red": "node --test src/red/red.contract.test.js",
    "test:contracts:hardware": "node --test src/hardware/hardware.contract.test.js",
    "test:contracts:operacion": "node --test src/operacion/operacion.cache.routes.test.js",
    "test:contracts:middleware": "node --test src/middleware/rateLimitProfiles.test.js src/middleware/shortLivedGetCache.test.js src/middleware/requestCoalescer.test.js",
    "test:contracts:validacion": "node --test src/services/validacionService.contract.test.js",
    "test:contracts:expediente-estados": "node --test src/expediente/ExpedienteService.state.test.js",
    "test:contracts:expediente-http": "node scripts/run-expediente-http-contract.js",
    "test:contracts:all": "npm run test:contracts:arquitectura && npm run test:contracts:auditoria && npm run test:contracts:edicion-servidores && npm run test:contracts:informes && npm run test:contracts:mantenimiento && npm run test:contracts:instalacion && npm run test:contracts:organizacion && npm run test:contracts:red && npm run test:contracts:hardware && npm run test:contracts:operacion && npm run test:contracts:middleware && npm run test:contracts:validacion && npm run test:contracts:expediente-estados && npm run test:contracts:expediente-http",
    "test:pre-release": "node scripts/pre-release-check.js",
    "test:production-readiness": "node scripts/pre-release-check.js",
    "ops:production-readiness": "node scripts/pre-release-check.js",
    "ops:smoke:interaction": "node scripts/smoke-interaction-check.js",
    "ops:smoke:auth": "node scripts/smoke-auth-flow.js",
    "ops:production:smoke:interaction": "node scripts/smoke-interaction-check.js",
    "ops:production:smoke:auth": "node scripts/smoke-auth-flow.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "pdfkit": "^0.18.0",
    "request-ip": "^3.3.0",
    "ssh2": "^1.17.0",
    "uuid": "^13.0.0"
  }
}
