# Auditor legacy deprecation controls
# Copy these values into your .env depending on environment.

# Enable/disable legacy route /api/centinela-banco-pruebas/auditor
# true  -> legacy route enabled
# false -> legacy route disabled (returns 410 + successor link)
ENABLE_AUDITOR_LEGACY=true

# Sunset date exposed by /auditor deprecation headers/payload
AUDITOR_LEGACY_SUNSET=2026-12-31T23:59:59Z

# Existing hardening flag for purge endpoints in /auditoria
ALLOW_AUDITORIA_PURGE=false
